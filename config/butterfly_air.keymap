/*
 * Butterfly Air - 48 key keymap
 *
 * Logical layout:
 *   4 rows x 12 columns = 48 positions
 *
 * Layer 0: Base Layer
 * Layer 1: Function & Symbol Layer
 * Layer 2: Bluetooth / Symbol Layer
 * Layer 3: Numpad Layer
 *
 * Physical blind-cap positions:
 *   Row 4 / Column 4 -> &trans
 *   Row 4 / Column 9 -> &trans
 *
 * These positions are physically wired but intentionally unused.
 */
/*
 * Butterfly Air - 48 key keymap (Safe Build Version)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        ID: ID {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp S &kp T &kp E &kp C &kp N0 &kp N7 &kp N6 &kp N4 &kp>;
            label = "ID";
        };

        pass: pass {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(N) &kp O &kp T &kp E &kp S &kp MINUS &kp N8 &kp N2 &kp N2 &kp N1>;
            label = "PASS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp Q     &kp W     &kp E   &kp R  &kp T      &kp Y  &kp U  &kp I           &kp O     &kp P     &kp BSPC
&kp TAB    &kp A     &kp S     &kp D   &kp F  &kp G      &kp H  &kp J  &kp K           &kp L     &kp SEMI  &kp RET
&kp LSHFT  &kp Z     &kp X     &kp C   &kp V  &kp B      &kp N  &kp M  &kp COMMA       &kp DOT   &kp UP    &kp DEL
&kp LCTRL  &kp LGUI  &kp LALT  &trans  &mo 3  &kp SPACE  &mo 1  &mo 2  &studio_unlock  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        layer_1 {
            display-name = "FuncSym";
            bindings = <
&kp F2    &kp F4  &trans  &trans  &trans  &trans  &trans     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &trans  &kp MINUS
&kp EXCL  &kp AT  &trans  &trans  &trans  &trans  &trans     &trans                &trans                 &trans  &trans  &trans
&trans    &trans  &trans  &trans  &trans  &trans  &kp MINUS  &kp QMARK             &ID                    &pass   &trans  &trans
&trans    &trans  &trans  &trans  &trans  &trans  &trans     &trans                &trans                 &trans  &trans  &trans
            >;
        };

        layer_2 {
            display-name = "BTSym";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_NXT
&trans  &trans  &trans  &trans  &trans  &trans  &bt BT_PRV    &bt BT_CLR    &studio_unlock  &out OUT_BLE  &out OUT_USB  &out OUT_TOG
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans          &kp LS(DOT)   &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans          &trans        &trans        &trans
            >;
        };

        layer_3 {
            display-name = "Numpad";
            bindings = <
&trans  &trans  &kp KP_N7  &kp KP_N8  &kp KP_N9  &trans     &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans  &trans  &trans
&trans  &trans  &kp KP_N4  &kp KP_N5  &kp KP_N6  &trans     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans  &trans  &trans
&trans  &trans  &kp KP_N1  &kp KP_N2  &kp KP_N3  &trans     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &kp KP_N0  &kp KP_NUMBER_0  &trans           &trans           &trans  &trans  &trans
            >;
        };
    };
};

/*
 * Pro Micro NRF52840 (Nice!Nano 互換) 用 2倍マトリクス定義
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        /* 行（ROW）ピンアサイン: D2, D3, D10, D16 */
        row-gpios
            = <&pro_micro 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* ROW0: D2  */
            , <&pro_micro 3  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* ROW1: D3  */
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* ROW2: D10 */
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* ROW3: D16 */
            ;

        /* 列（COL）ピンアサイン: D4, D5, D6, D18, D15, D14 */
        col-gpios
            = <&pro_micro 4  GPIO_ACTIVE_HIGH> /* COL0: D4  */
            , <&pro_micro 5  GPIO_ACTIVE_HIGH> /* COL1: D5  */
            , <&pro_micro 6  GPIO_ACTIVE_HIGH> /* COL2: D6  */
            , <&pro_micro 18 GPIO_ACTIVE_HIGH> /* COL3: D18 */
            , <&pro_micro 15 GPIO_ACTIVE_HIGH> /* COL4: D15 */
            , <&pro_micro 14 GPIO_ACTIVE_HIGH> /* COL5: D14 */
            ;
    };

    /* 2倍マトリックス（QMK LAYOUT構造からのマッピング） */
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <13>;
        rows = <11>;

        map = <
            RC(0,4) RC(4,0) RC(0,5) RC(5,0) RC(0,6) RC(6,0) RC(0,7) RC(7,0) RC(0,8) RC(8,0) RC(0,9) RC(9,0) RC(0,10)
            RC(1,4) RC(4,1) RC(1,5) RC(5,1) RC(1,6) RC(6,1) RC(1,7) RC(7,1) RC(1,8) RC(8,1) RC(1,9) RC(9,1) RC(1,10)
            RC(2,4) RC(4,2) RC(2,5) RC(5,2) RC(2,6) RC(6,2) RC(2,7) RC(7,2) RC(2,8) RC(8,2) RC(2,9) RC(9,2) RC(2,10)
            RC(3,4) RC(4,3) RC(3,5) RC(5,3) RC(3,6) RC(6,3) RC(3,7) RC(7,3) RC(3,8) RC(8,3) RC(3,9) RC(9,3) RC(3,10)
        >;
    };
};

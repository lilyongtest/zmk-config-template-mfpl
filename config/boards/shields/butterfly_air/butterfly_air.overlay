/*
 * Butterfly Air
 *
 * 4 ROW x 6 COL Japanese Duplex Matrix = 48 keys
 *
 * Physical GPIO assignment:
 *   ROW0 = D2
 *   ROW1 = D3
 *   ROW2 = D10
 *   ROW3 = D16
 *   COL0 = D4
 *   COL1 = D5
 *   COL2 = D6
 *   COL3 = D18
 *   COL4 = D15
 *   COL5 = D14
 *
 * Each physical ROW/COL intersection has two diodes:
 *   ROW -> COL
 *   COL -> ROW
 *
 * ZMK's built-in charlieplex kscan driver is used. No custom C driver
 * is required: the 10 GPIOs are treated as a 10-pin charlieplex space,
 * and the matrix transform exposes only the 48 wired directions.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-charlieplex";

        /*
         * Charlieplex GPIO indices:
         *   0..3 = ROW0..ROW3
         *   4..9 = COL0..COL5
         *
         * All GPIOs must use GPIO_ACTIVE_HIGH for this driver.
         */
        gpios
            = <&pro_micro 2  GPIO_ACTIVE_HIGH>  /* 0: ROW0 */
            , <&pro_micro 3  GPIO_ACTIVE_HIGH>  /* 1: ROW1 */
            , <&pro_micro 10 GPIO_ACTIVE_HIGH>  /* 2: ROW2 */
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>  /* 3: ROW3 */
            , <&pro_micro 4  GPIO_ACTIVE_HIGH>  /* 4: COL0 */
            , <&pro_micro 5  GPIO_ACTIVE_HIGH>  /* 5: COL1 */
            , <&pro_micro 6  GPIO_ACTIVE_HIGH>  /* 6: COL2 */
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>  /* 7: COL3 */
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>  /* 8: COL4 */
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>  /* 9: COL5 */
            ;

        debounce-press-ms = <5>;
        debounce-release-ms = <5>;
        debounce-scan-period-ms = <1>;
        poll-period-ms = <10>;
    };

    /*
     * Current ZMK keyboard-shield structure uses a physical-layout node
     * to associate the kscan and matrix transform. No physical key
     * coordinates are supplied yet, so this is the basic (non-Studio)
     * physical layout form.
     */
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>;
        transform = <&default_transform>;
    };

    /*
     * Logical matrix: 4 rows x 12 columns = 48 positions.
     *
     * Each physical intersection contributes two logical positions:
     *
     *   RC(row, col) = ROW -> COL
     *   RC(col, row) = COL -> ROW
     *
     * Example for ROW0/COL0 (GPIO 0 / GPIO 4):
     *   RC(0,4) = diode direction ROW0 -> COL0
     *   RC(4,0) = diode direction COL0 -> ROW0
     */
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";

        rows = <4>;
        columns = <12>;

        map = <
            /* ROW0 */
            RC(0,4) RC(4,0)  RC(0,5) RC(5,0)  RC(0,6) RC(6,0)
            RC(0,7) RC(7,0)  RC(0,8) RC(8,0)  RC(0,9) RC(9,0)

            /* ROW1 */
            RC(1,4) RC(4,1)  RC(1,5) RC(5,1)  RC(1,6) RC(6,1)
            RC(1,7) RC(7,1)  RC(1,8) RC(8,1)  RC(1,9) RC(9,1)

            /* ROW2 */
            RC(2,4) RC(4,2)  RC(2,5) RC(5,2)  RC(2,6) RC(6,2)
            RC(2,7) RC(7,2)  RC(2,8) RC(8,2)  RC(2,9) RC(9,2)

            /* ROW3 */
            RC(3,4) RC(4,3)  RC(3,5) RC(5,3)  RC(3,6) RC(6,3)
            RC(3,7) RC(7,3)  RC(3,8) RC(8,3)  RC(3,9) RC(9,3)
        >;
    };
};
